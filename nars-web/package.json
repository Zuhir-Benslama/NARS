{
  "name": "nars-frontend-maplibre",
  "version": "1.0.0",
  "description": "NARS — National Addressing Reference System (Maplibre GL JS version)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:deploy": "vue-tsc --noEmit && vite build && rm -rf ../../nars-api/wwwroot/assets && cp -r dist/* ../../nars-api/wwwroot/",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "audit": "npm audit --audit-level=high",
    "prepare": "",
    "codegen:fetch-spec": "curl -s http://localhost:5000/openapi/v1.json -o api-spec/openapi.json",
    "codegen:types": "openapi-typescript api-spec/openapi.json -o src/api/schema.d.ts",
    "codegen": "npm run codegen:fetch-spec && npm run codegen:types"
  },
  "dependencies": {
    "@geoman-io/maplibre-geoman-free": "^0.8.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation-document-load": "^0.64.0",
    "@opentelemetry/instrumentation-fetch": "^0.219.0",
    "@opentelemetry/sdk-trace-web": "^2.8.0",
    "@turf/distance": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/length": "^7.3.5",
    "@turf/line-intersect": "^7.3.5",
    "@turf/nearest-point-on-line": "^7.3.5",
    "dompurify": "^3.4.10",
    "graphology": "^0.26.0",
    "maplibre-gl": "^5.24.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.4",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "overrides": {
    "glob": "^11.0.0",
    "js-yaml": "^4.2.0",
    "openapi-typescript": {
      "typescript": "^6.0.3"
    }
  }
}
