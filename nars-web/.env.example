# nars-vite (Vue 3 Frontend) — Environment Variables
# Copy to .env or set at build/runtime time.

# Backend URL for Vite dev server proxy (default: http://localhost:5000)
# VITE_DEV_BACKEND=http://localhost:5000

# Base URL prefix for API requests (e.g. "/api" behind a reverse proxy, or a
# full origin). Empty by default — requests are same-origin.
# VITE_API_BASE=

# OpenTelemetry OTLP HTTP endpoint for browser traces.
# Default: "/v1/traces" (same-origin, proxied via nginx to the collector in prod).
# In development, set this to a local collector (e.g. http://localhost:4318/v1/traces)
# or omit it — failures are non-blocking.
# VITE_OTEL_ENDPOINT=/v1/traces

# Set to "1" / "true" to opt out of telemetry entirely, even when the endpoint
# is configured. Query strings and URL fragments are always stripped from
# captured spans regardless of this flag.
# VITE_OTEL_DISABLED=false

# Optional regex (JS RegExp source) of cross-origin URLs to allow as OTel
# trace context carriers. Invalid patterns are logged and ignored.
# VITE_OTEL_CORS_URLS=

# Tile URL overrides. Falls back to hardcoded defaults if unset.
# VITE_TILE_SATELLITE=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_TILE_STREET=https://a.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_LIGHT=https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
# VITE_TILE_DARK=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
