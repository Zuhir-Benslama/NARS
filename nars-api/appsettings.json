{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=nars_db;Username=postgres;Password=${NARS_DB_PASSWORD}"
  },
  "Jwt": {
    "SecretKey": "${NARS_JWT_SECRET}",
    "Algorithm": "HS256",
    "ExpiresInMinutes": 60,
    "RefreshExpiresInDays": 7,
    "Issuer": "NarsApi",
    "Audience": "NarsFrontend"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://localhost:5001",
      "https://localhost:7000",
      "https://localhost:7001",
      "http://localhost:5173"
    ]
  },
  "AllowedHosts": "localhost",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "MaxBatchSize": 50,
    "MaxEntryLength": 10000
  },
  "RateLimit": {
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 30,
    "AuthSegmentsPerWindow": 3,
    "ClearPermitLimit": 3,
    "ClearWindowMinutes": 10,
    "ApiPermitLimit": 60,
    "ApiWindowMinutes": 1,
    "ApiSegmentsPerWindow": 6
  },
  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 30
  },
  "Validation": {
    "MaxCoordinateCount": 10000,
    "RoadTurnAngleDegrees": 90.0,
    "RoadConnectivityMeters": 20.0,
    "DistrictBoundaryToleranceMeters": 10.0
  },
  "FeatureDefaults": {
    "MaxFeatureDataSize": 524288,
    "MultipartBodyLengthLimit": 10485760,
    "ValueLengthLimit": 1048576
  },
  "Locations": {
    "MaxSearchLength": 200
  },
  "Cache": {
    "ReferenceDataDurationHours": 1,
    "PageTemplateDurationHours": 1
  },
  "HttpClient": {
    "TileProxyTimeoutSeconds": 15,
    "SatelliteTimeoutSeconds": 30
  },
  "BackgroundTask": {
    "Capacity": 100,
    "GracePeriodSeconds": 5
  },
  "AdminSignup": {
    "SignupToken": "${NARS_ADMIN_SIGNUP_TOKEN}"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector.observability:4317"
  },
  "Csp": {
    "DefaultSrc": "'self'",
    "ScriptSrc": "'self' blob:",
    "WorkerSrc": "'self' blob:",
    "StyleSrc": "'self' https://cdn.jsdelivr.net https://unpkg.com 'nonce-' https://fonts.googleapis.com",
    "ImgSrc": "'self' data: blob: https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://*.arcgisonline.com",
    "FontSrc": "'self' https://cdn.jsdelivr.net https://fonts.gstatic.com",
    "ConnectSrc": "'self' https: data: https://*.arcgisonline.com https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com",
    "FrameAncestors": "'none'",
    "BaseUri": "'self'",
    "FormAction": "'self'"
  }
}
