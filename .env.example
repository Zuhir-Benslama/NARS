# NARS Cluster Configuration
# Copy to .env and fill in your values.
# Auto-generated defaults are used for any unset variables.

# Docker registry credentials (required to pull private images)
DOCKER_USERNAME=zuhirbenslama
DOCKER_TOKEN=

# Secrets (auto-generated with openssl rand if left empty)
# GPG_PASSPHRASE: used by the backup CronJob to encrypt pg_dump backups.
# NARS_ADMIN_SIGNUP_TOKEN: bearer token required by the admin signup endpoint.
POSTGRES_PASSWORD=
JWT_SECRET=
GPG_PASSPHRASE=
GRAFANA_PASSWORD=
NARS_ADMIN_SIGNUP_TOKEN=
NARS_ROADS_INTERNAL_TOKEN=
# Where the nars-roads initContainer downloads the model checkpoint from
# (e.g. a signed object-store URL). If empty, the pod init fails fast instead
# of running with random weights.
NARS_ROADS_WEIGHTS_URL=https://hf.co/nilsho01/unet-resnet34-vhr-buildings/resolve/main/unet_bldg_base.pth

# Cluster settings (optional overrides)
# CLUSTER_NAME=nars
# DOMAIN=nars.dz

# OpenTelemetry — override the default OTLP gRPC endpoint for the backend.
# Default: http://otel-collector.observability:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4317
