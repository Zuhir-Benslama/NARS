# NARS Cluster Configuration
# Copy to .env and fill in your values.
# Auto-generated defaults are used for any unset variables.

# Docker registry credentials (required to pull private images)
DOCKER_USERNAME=zuhirbenslama
DOCKER_TOKEN=

# Secrets (auto-generated with openssl rand if left empty)
# GPG_PASSPHRASE: used by the backup CronJob to encrypt pg_dump backups.
# NARS_ADMIN_SIGNUP_TOKEN: bearer token required by the admin signup endpoint.
POSTGRES_PASSWORD=
JWT_SECRET=
GPG_PASSPHRASE=
GRAFANA_PASSWORD=
NARS_ADMIN_SIGNUP_TOKEN=
NARS_SEGMA_INTERNAL_TOKEN=
# Where the nars-segma initContainer downloads the model checkpoint from
# (e.g. a signed object-store URL). If empty, the pod init fails fast instead
# of running with random weights.
NARS_SEGMA_WEIGHTS_URL=https://hf.co/nilsho01/unet-resnet34-vhr-buildings/resolve/main/unet_bldg_base.pth
# NOTE: there is deliberately no NARS_SEGMA_ROAD_WEIGHTS_URL any more. The
# roads weights ship inside the nars-segma image (baked at /srv/weights-baked by
# Dockerfile.nars-segma, copied into the pod's emptyDir by the
# seed-road-weights initContainer). It used to be downloaded from a URL here,
# but that pointed at the raw SpaceNet champion *pickle* while the builder is
# deeplabv3p-convnext: torch.load(weights_only=True) rejected it, the task was
# left unregistered and /segment/roads returned 503 for every request. The
# checkpoint (nars-roads/checkpoints/roads_dlv3p_convnext_tiny.pth) is
# gitignored, so a build host needs it present at nars-segma/weights/.
# Road rules (limitation) enforced inside nars-segma before features leave the
# service. The confidence floor is the lever that matters: the mask threshold
# (0.5) leaves marginal pixels whose skeleton spurs are ~3 m long, and those
# spurs — not the roads — are what made drafts look like roads crossing each
# other. Deployed at 0.6, which on the commune's own 1,837 road drafts took the
# median draft from 8.2 m to 38.2 m and the sub-10 m share from 53% to 25% while
# keeping 91% of network length. Raise to 0.7 (median 56 m, 17% under 10 m,
# 85% of length) only after eyeballing a tile — each step discards real
# low-confidence road. The length floor stays 0: a short edge is the API's
# roads-phase decision, not segma's, because only the API sees the mapped network.
#   NARS_SEGMA_ROAD_MIN_LENGTH_M   — drop edges shorter than this (metres)
#   NARS_SEGMA_ROAD_MIN_CONFIDENCE — drop edges with lower mean confidence
#   NARS_SEGMA_ROAD_MAX_FEATURES   — per-tile cap (0 = no cap)
# Building rules (limitation), same shape:
#   NARS_SEGMA_BUILDING_MIN_CONFIDENCE
#   NARS_SEGMA_BUILDING_MAX_FEATURES
# NARS_SEGMA_ROAD_MIN_LENGTH_M=0
# NARS_SEGMA_ROAD_MIN_CONFIDENCE=0.6
# NARS_SEGMA_ROAD_MAX_FEATURES=500
# Road network cleanup, applied after extraction (see nars-segma/app/roadnet.py).
# The angle/deviation pair removes "dents" — shallow kinks the skeleton traces
# between neighbouring pixels of coarse imagery; Douglas-Peucker cannot, because
# the wobble is larger than the simplify tolerance. Set either to 0 to disable.
# The node tolerance makes crossings shared junctions, and ships 0 (off): these
# drafts are already fragments, so every cut falls under the API's 10 m
# MinRoadLengthM floor and gets deleted downstream. Only crossings at least
# MIN_NODE_ANGLE_DEG sharp are noded; shallower ones are twin centrelines of one
# road, not a junction.
#   NARS_SEGMA_ROAD_NET_MAX_ANGLE_DEG        — max turn to still count as a dent
#   NARS_SEGMA_ROAD_NET_MAX_DEVIATION_RATIO  — dent cap, as a fraction of the
#                                               shorter neighbouring segment
#   NARS_SEGMA_ROAD_NET_NODE_TOLERANCE_M     — 0 disables noding
#   NARS_SEGMA_ROAD_NET_MIN_NODE_ANGLE_DEG   — only node crossings this sharp
# NARS_SEGMA_ROAD_NET_MAX_ANGLE_DEG=20
# NARS_SEGMA_ROAD_NET_MAX_DEVIATION_RATIO=0.30
# NARS_SEGMA_ROAD_NET_NODE_TOLERANCE_M=0
# NARS_SEGMA_ROAD_NET_MIN_NODE_ANGLE_DEG=20

# Cluster settings (optional overrides)
# CLUSTER_NAME=nars
# DOMAIN=nars.dz

# OpenTelemetry — override the default OTLP gRPC endpoint for the backend.
# Default: http://otel-collector.observability:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4317
