<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NarsApi.Tests</RootNamespace>
    <!-- Same gate as nars-api: any compiler/analyzer warning breaks the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Coverage thresholds for coverlet.msbuild, applied only when coverage is
      collected (`dotnet test /p:CollectCoverage=true` — see `make test-coverage`).
      These are a REGRESSION FLOOR, not a target. CI enforces coverage on the
      UNIT-ONLY run (filter Category!=Service), so the floor must fit the
      lower of the two measured runs (excludes generated code — see the Exclude
      property below). Last measured 2026-08-16:
        - unit-only (what CI gates on): ~61.5% line / 53.6% branch
        - full suite incl. service tests: ~77.3% line / 67.1% branch
      Raise as coverage improves — do not lower. The single Threshold value
      applies to both line and branch, so it is capped by the lower (branch)
      metric of the unit-only run.
      Defined here (not on the CLI) because the vstest command-line parser
      splits comma-separated /p: values (e.g. ThresholdType=line,branch).
    -->
    <Threshold Condition="'$(CollectCoverage)' == 'true'">50</Threshold>
    <ThresholdType Condition="'$(CollectCoverage)' == 'true'">line,branch</ThresholdType>
    <ThresholdStat Condition="'$(CollectCoverage)' == 'true'">total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <!--
      Not referenced by test code — do NOT delete as "unused". It overrides
      the transitive SSH.NET that Testcontainers pulls in: Testcontainers
      floors it at vulnerable 2025.1.0 (GHSA-q939-rpr3-3284 / CVE-2026-48798)
      and NuGet resolves transitives to the lowest matching version, so a
      clean restore fails with NU1903 unless this direct reference elevates
      it to the patched release. Remove only once Testcontainers itself
      depends on >= 2026.0.0.
    -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.analyzers" Version="1.22.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\nars-api\NarsApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Coverage exclusions: EF Core migrations (including *.Designer.cs and the
    model snapshot) and the OpenAPI source-generator output are generated code
    that cannot be meaningfully unit-tested. Counting them against the coverage
    floor inflates the denominator by ~50% and hides real regressions.
    Applied only when coverage is collected (dotnet test /p:CollectCoverage=true).
  -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Exclude>[NarsApi]NarsApi.Migrations.*,[NarsApi]Microsoft.AspNetCore.OpenApi.Generated.*,[NarsApi]System.Runtime.CompilerServices.*</Exclude>
  </PropertyGroup>

</Project>
