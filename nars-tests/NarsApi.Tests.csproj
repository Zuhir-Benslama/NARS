<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NarsApi.Tests</RootNamespace>
    <!--
      Coverage thresholds for coverlet.msbuild, applied only when coverage is
      collected (`dotnet test /p:CollectCoverage=true` — see `make test-coverage`).
      These are a REGRESSION FLOOR, not a target: measured 2026-08-02 was
      ~43.7% line / 38.8% branch (unit tests only, as CI runs them; excludes
      generated code — see the Exclude property below). Raise as coverage
      improves — do not lower.
      Defined here (not on the CLI) because the vstest command-line parser
      splits comma-separated /p: values (e.g. ThresholdType=line,branch).
    -->
    <Threshold Condition="'$(CollectCoverage)' == 'true'">35</Threshold>
    <ThresholdType Condition="'$(CollectCoverage)' == 'true'">line,branch</ThresholdType>
    <ThresholdStat Condition="'$(CollectCoverage)' == 'true'">total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.analyzers" Version="1.22.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\nars-api\NarsApi.csproj" />
  </ItemGroup>

  <!--
    Coverage exclusions: EF Core migrations (including *.Designer.cs and the
    model snapshot) and the OpenAPI source-generator output are generated code
    that cannot be meaningfully unit-tested. Counting them against the coverage
    floor inflates the denominator by ~50% and hides real regressions.
    Applied only when coverage is collected (dotnet test /p:CollectCoverage=true).
  -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Exclude>[NarsApi]NarsApi.Migrations.*,[NarsApi]Microsoft.AspNetCore.OpenApi.Generated.*,[NarsApi]System.Runtime.CompilerServices.*</Exclude>
  </PropertyGroup>

</Project>
