# ─── Self-hosted satellite tile server (nginx + MapServer) ──────────────────
# nginx serves the pre-built XYZ pyramid from /data/tiles as immutable static
# files (the hot path: MapLibre fetches byte-stable PNGs and nginx never
# touches GDAL), and proxies WMS to MapServer via a fcgiwrap socket. WMS is the
# on-demand re-render path used for tiles that were built but must be served
# dynamically (GetMap / GetCapabilities / mode=tile).
#
# Data layout (mounted volume at /data):
#   /data/tiles/{z}/{x}/{y}.png   gdal2tiles --xyz pyramid (static XYZ serving)
#   /data/sources/*.tif           urban-clipped EPSG:3857 source rasters (WMS)
#   /data/sources/tileindex.gpkg  gdaltindex footprint index feeding the WMS layer
#
# Build from repo root:
#   docker build -f nars-infra/docker/Dockerfile.nars-tiles -t nars-tiles:latest .
FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

LABEL org.opencontainers.image.title="NARS Tile Server" \
      org.opencontainers.image.description="nginx-served XYZ satellite tiles + MapServer WMS for NARS" \
      org.opencontainers.image.source="https://github.com/zuhirbenslama/nars"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# TILES_DATA_DIR is the mount root (pyramid under /data/tiles, WMS sources under
# /data/sources). TILES_PUBLIC_URL is advertised in WMS GetCapabilities as the
# onlineresource (templated into the mapfile at boot by the entrypoint).
ENV DEBIAN_FRONTEND=noninteractive
ENV TILES_DATA_DIR=/data
ENV TILES_PUBLIC_URL=
# MapServer >=8.0 global config; Debian's cgi-mapserver REQUIRES MS_MAP_PATTERN
# (see mapserver.conf) and refuses requests without it. Must be set explicitly
# or the CGI is stuck in msLoadConfig.
ENV MAPSERVER_CONFIG_FILE=/etc/mapserver/mapserver.conf

# Pinned with wildcard suffixes (security patches within the series), matching
# the repo's apt pin convention — see nars-infra/.hadolint.yaml (dl3008).
# cgi-mapserver ships /usr/lib/cgi-bin/mapserv; nginx-light + fcgiwrap expose
# it at /wms; gdal-bin/proj-bin are CLI debug tools for the box itself (data
# prep runs in the dedicated GDAL image).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        cgi-mapserver=8.4.0-* \
        fcgiwrap=1.1.0-* \
        spawn-fcgi=1.6.6-* \
        nginx-light=1.26.3-* \
        gdal-bin=3.10.3+dfsg-1* \
        proj-bin=9.6.0-* \
        curl=8.14.1-* \
        ca-certificates=2025* \
    && rm -rf /var/lib/apt/lists/* \
    # Debian's nginx ships a default site that also listens :80; drop it so the
    # tiles server block is the sole vhost.
    && rm -rf /etc/nginx/sites-enabled/default

COPY nars-infra/docker/mapserver/xyz.map /etc/mapserver/xyz.map
COPY nars-infra/docker/mapserver/mapserver.conf /etc/mapserver/mapserver.conf
COPY nars-infra/docker/mapserver/mapserv.conf /etc/nginx/conf.d/default.conf
# Overlays Debian's default nginx.conf: logs moved to /dev/stderr + /dev/stdout
# (see nginx.conf header for the rootless-runtime rationale).
COPY nars-infra/docker/nginx.conf /etc/nginx/nginx.conf
COPY nars-infra/scripts/mapserver-entrypoint.sh /usr/local/bin/mapserver-entrypoint.sh

# fcgiwrap socket dir. Root-owned on purpose: the entrypoint creates the socket
# there as root and spawn-fcgi chowns just the socket to www-data, so neither a
# normal nor a rootless (uid-mapped) runtime ever needs to write into the dir
# as the mapped www-data uid.
RUN mkdir -p /run/fcgiwrap

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -fsS -o /dev/null "http://localhost:80/wms?SERVICE=WMS&VERSION=1.1.1&REQUEST=GetCapabilities" || exit 1

STOPSIGNAL SIGQUIT
CMD ["mapserver-entrypoint.sh"]