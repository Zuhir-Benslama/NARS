# ─── PostGIS Backup Image ──────────────────────────────────────────────
# Extends postgres:17-alpine with gnupg for GPG-encrypted pg_dump backups.
# This avoids installing gnupg at runtime on every CronJob execution.
FROM postgres:18-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2

LABEL org.opencontainers.image.title="NARS Backup" \
      org.opencontainers.image.description="GPG-encrypted pg_dump backups" \
      org.opencontainers.image.source="https://github.com/zuhirbenslama/nars"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apk add --no-cache gnupg=2.4.9-r1
