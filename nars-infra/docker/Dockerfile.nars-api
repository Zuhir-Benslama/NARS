# ─── Backend (ASP.NET Core API) ───────────────────────────────────────────────
# Build from repo root:
#   docker build -f nars-infra/docker/Dockerfile.nars-api -t nars-api:latest .
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS base

LABEL org.opencontainers.image.title="NARS API" \
      org.opencontainers.image.description="NARS ASP.NET Core backend" \
      org.opencontainers.image.source="https://github.com/zuhirbenslama/nars"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# curl is needed for Docker HEALTHCHECK. The ~5MB is a deliberate trade-off
# for non-K8s deployments (docker-compose, local runs) that rely on HEALTHCHECK.
# Pinned to the 8.5.0-2ubuntu10 series (wildcard) for hadolint DL3008 compliance,
# while tolerating security patch bumps within the same series.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl=8.5.0-2ubuntu10* \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
USER 1654
EXPOSE 8080
# This ENV takes precedence over appsettings.json — config file changes are ignored.
ENV ASPNETCORE_URLS=http://+:8080

FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
WORKDIR /src
COPY ["Directory.Build.props", "./"]
COPY ["nars-api/NarsApi.csproj", "nars-api/"]
RUN dotnet restore "nars-api/NarsApi.csproj"
COPY nars-api/ nars-api/

FROM build AS publish
RUN dotnet publish "nars-api/NarsApi.csproj" --configuration Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish /app/
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1
ENTRYPOINT ["dotnet", "NarsApi.dll"]
