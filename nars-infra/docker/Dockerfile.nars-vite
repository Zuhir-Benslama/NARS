# ─── Frontend (Vue 3 + Vite) ─────────────────────────────────────────────────
# Build from repo root:
#   docker build -f nars-infra/docker/Dockerfile.nars-vite -t nars-vite:latest .
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build
WORKDIR /app
COPY nars-web/package.json nars-web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY nars-web/ .
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS final

LABEL org.opencontainers.image.title="NARS Vite Frontend" \
      org.opencontainers.image.description="NARS Vue 3 + Vite frontend" \
      org.opencontainers.image.source="https://github.com/zuhirbenslama/nars"
COPY --from=build /app/dist /usr/share/nginx/html
COPY nars-infra/docker/nginx.nars-vite.conf /etc/nginx/conf.d/default.conf
COPY nars-infra/docker/proxy-common-snippet.conf /etc/nginx/snippets/proxy-common.conf
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/ || exit 1
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
