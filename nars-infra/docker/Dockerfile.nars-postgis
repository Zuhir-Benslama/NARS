FROM postgis/postgis:17-3.5@sha256:efbd2cb72d4067c6973ed8ac1c35741ae2d54cc1f927516d67ce0a11be55aef3

LABEL org.opencontainers.image.title="NARS PostGIS" \
      org.opencontainers.image.description="NARS PostgreSQL + PostGIS database" \
      org.opencontainers.image.source="https://github.com/zuhirbenslama/nars"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ⚠ These paths assume the build context is the repo root (../..).
# Building from this directory (nars-infra/docker/) will fail.
# CI always sets context to the repo root.
COPY nars-infra/scripts/create_nars_db.sql /docker-entrypoint-initdb.d/01-nars-schema.sql
COPY nars-infra/docs/seed_reference_data.sql /docker-entrypoint-initdb.d/02-seed-reference-data.sql

EXPOSE 5432

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD pg_isready -U postgres -d nars_db -h localhost
