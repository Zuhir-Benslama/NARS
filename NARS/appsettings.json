{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=nars_db;Username=postgres;Password=${NARS_DB_PASSWORD}"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_IN_PRODUCTION_32_CHAR_LONG_SECRET_KEY",
    "Algorithm": "HS256",
    "ExpiresInMinutes": 1440,
    "RefreshExpiresInDays": 30,
    "Issuer": "NarsApi",
    "Audience": "NarsFrontend"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://localhost:5001",
      "https://localhost:7000",
      "https://localhost:7001",
      "http://localhost:5173"
    ]
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimit": {
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 30,
    "AuthSegmentsPerWindow": 3,
    "ClearPermitLimit": 3,
    "ClearWindowMinutes": 10,
    "ApiPermitLimit": 60,
    "ApiWindowMinutes": 1,
    "ApiSegmentsPerWindow": 6
  }
}
